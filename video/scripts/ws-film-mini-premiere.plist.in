<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>au.wssolutions.mini-premiere</string>
  <key>ProgramArguments</key>
  <array><string>__PYTHON__</string><string>__FILM_DIR__/local_app.py</string></array>
  <key>WorkingDirectory</key><string>__FILM_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__FILM_DIR__/.local/server.log</string>
  <key>StandardErrorPath</key><string>__FILM_DIR__/.local/server-error.log</string>
</dict>
</plist>
